# Banco de dados
DATABASE_URL="postgresql://modorir:modorir@localhost:5432/modorir?schema=public"

# API
API_PORT=3000
API_PREFIX=api/v1

# CORS (origem do frontend AgroERP_Demo_16_79.html em desenvolvimento)
CORS_ORIGIN=*

# Autoria das ações nos módulos que ainda usam o header x-user
# (Boletas/Cadastros/Parametrizações) — ver src/common/decorators/current-user.decorator.ts
AUDITORIA_USUARIO_PADRAO=sistema

# Autenticação JWT (Auth/RBAC — docx §12.3). TROCAR OS SEGREDOS EM PRODUÇÃO!
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-em-producao
JWT_REFRESH_EXPIRES_IN=7d
